# 이 파일을 복사해서 server/.env 로 만들고 값을 채운다. (.env 는 커밋 금지)
SPRING_PROFILES_ACTIVE=local

# JWT (32바이트 이상 랜덤 문자열)
JWT_SECRET=
JWT_ACCESS_EXPIRATION_MS=86400000

# DB (prod 프로필에서만 사용)
DB_URL=jdbc:mysql://<rds-endpoint>:3306/itda
DB_USERNAME=
DB_PASSWORD=

# AWS 공통 — 로컬에선 아래 키, EC2에선 IAM Role 사용 권장
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 / CloudFront
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=

# Bedrock (Claude 모델 ID 또는 inference profile ID)
BEDROCK_MODEL_ID=

# Polly
AWS_POLLY_VOICE_ID=Seoyeon

# 영상 합성
FFMPEG_PATH=ffmpeg
VIDEO_WORK_DIR=./tmp/video

# CORS (쉼표로 여러 개)
CORS_ALLOWED_ORIGINS=http://localhost:5173
